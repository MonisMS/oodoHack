# Copy to server/.env. Local PostgreSQL only; never commit credentials.
DATABASE_URL="postgresql://brightloop:brightloop@localhost:5432/brightloop?schema=public"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Development-only shortcut (x-dev-* headers act as a signed-in user). Off by default; when on it only works for requests
# from this machine, and the server refuses to start with it enabled in production. Prefer real sign-in with the fixture users.
DEV_AUTH_ENABLED=false
# Better Auth (cookie sessions). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <billing@brightloop.local>
# Monis billing engine: enable the daily UTC scheduler after applying migrations.
BILLING_CRON_ENABLED=false
BILLING_CRON=0 0 * * *
# Auth rate limits (sign-in 8/min, sign-up 5/min, reset 3/min per IP). On everywhere except NODE_ENV=test; set false to disable locally.
# AUTH_RATE_LIMIT=true
# The API binds to this address. "localhost" = both loopback addresses (127.0.0.1 and ::1), reachable only from this machine.
# Behind a reverse proxy on another host set it deliberately (for example 0.0.0.0).
HOST=localhost
# Set true ONLY when the API sits behind a trusted reverse proxy that sets X-Forwarded-For; otherwise the header is ignored.
TRUST_PROXY=false
# Business calendar for "today" (payment dates, overdue checks, pause/close decisions).
BUSINESS_TZ=Asia/Kolkata

