# Copy to server/.env. Local PostgreSQL only; never commit credentials.
DATABASE_URL="postgresql://brightloop:brightloop@localhost:5432/brightloop?schema=public"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Explicit opt-in; the server refuses to start with this enabled in production.
DEV_AUTH_ENABLED=true
# Better Auth (cookie sessions). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <billing@brightloop.local>
# Scheduled billing stays off until A implements its transaction service.
BILLING_CRON_ENABLED=false
BILLING_CRON=0 0 * * *
